MONGO_CONNECTION_STRING=
MONGO_DB_NAME=pastebin
MONGO_COLLECTION_NAME=pastes
KEY_LENGTH=6
MAX_PASTE_SIZE=10000
FLASK_DEBUG=False
FLASK_PORT=5000
FLASK_HOST=0.0.0.0

SECRET_KEY= your_secret_key
# Encryption key for encrypting paste data at rest.
# If set, all pastes are encrypted using AES-256 before storing in DB.
# If not set, pastes are stored in plaintext (not recommended for production).
# For password-protected pastes, the user's password is used as the encryption key instead.
ENCRYPTION_KEY=change-me-to-a-random-string
# Environment - set to "prod" for production (enforces SECRET_KEY, secure cookies, HSTS)
# Independent of how static files are served — see USE_CDN_STATIC below
FLASK_ENV=dev

# Serve static assets (CSS/JS/img) via CDN (S3/CloudFront)
# true  → templates use STATIC_BASE_URL; Flask does NOT serve public/
# false → Flask serves public/; templates use relative paths (/css/...)
# On Vercel, public/ is also published via @vercel/static when USE_CDN_STATIC=false
USE_CDN_STATIC=false

# CDN/S3 base URL for static files (only used when USE_CDN_STATIC=true)
# No trailing slash. e.g. https://my-bucket.s3.ap-south-1.amazonaws.com
STATIC_BASE_URL=https://<S3_BUCKET_NAME>.s3.ap-south-1.amazonaws.com

# Admin panel credentials
ADMIN_USERNAME=admin
ADMIN_PASSWORD=change-me-to-a-strong-password